---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const features = [
  {
    title: 'B2B ENTERPRISE API GATEWAY',
    status: 'KONZEPTPHASE',
    beta: false,
    body: 'Standardisierte Schnittstelle (REST, GraphQL, gRPC, MQTT, OPC-UA oder beliebiges anderes Protokoll) für industrielle Großbäckereien, Mühlen, Zuckerraffinerien und die pharmazeutische Großlogistik. Ein Sensor-Datenstrom — Kamerabild, Barcode/RFID, Gewichts-, Temperatur- oder Feuchtesensor — repräsentiert die Substanz-Charge am laufenden Band; daraus wird eine bewusst bedeutungslose Prüfsumme berechnet, die Potenzierung der Charge deklariert und als signiertes Zertifikat (Substanz, Potenzstufe, Zeitstempel, Prüfsumme) zurückgegeben, inklusive Webhook an ERP- und Warenwirtschaftssysteme.',
    variants:
      'Umfasst: Cloud-, On-Premise- und Edge-Deployment · Einzelstück- und Batch-Potenzierung · beliebige Sensorik · maschinenlesbare Siegel und QR-Codes auf Verpackungen.',
  },
  {
    title: 'BIOCHEMISCHES BETA-PROGRAMM (SCHÜSSLER-SALZE)',
    status: 'BETA — JETZT IM VORABZUGANG',
    beta: true,
    body: 'Erweiterung der Substanz-Bibliothek um sämtliche Funktions- und Ergänzungsmittel nach Dr. Wilhelm Heinrich Schüssler (Nr. 1 Calcium fluoratum bis Nr. 27 Kalium bichromicum) sowie beliebige weitere Nosoden-, Komplexmittel- und Bachblüten-Kataloge, jeweils mit frei wählbarer Potenzstufe auf beliebiger Skala (D, C, LM/Q, Korsakoff). In Vorbereitung: haptische Resonanzsimulation — ein aus der Substanz-Prüfsumme abgeleitetes Vibrationsmuster über die Haptik beliebiger Endgeräte.',
    variants:
      'Umfasst: beliebige Substanzkataloge · haptische, akustische („Klangpotenzierung") und optische Ausgabekanäle · Kopplung mehrerer Endgeräte zum Resonanzverbund.',
    link: `${base}#bibliothek`,
    linkLabel: 'Jetzt im Vorabzugang testen →',
  },
  {
    title: 'DISTRIBUTED-LEDGER-PROVENANCE (PROOF-OF-SACRIFICE)',
    status: 'IN ENTWICKLUNG',
    beta: false,
    body: 'Jede abgeschlossene Rechenphase des Energetischen Nachweises wird als Hash der Telemetrie (Chunk-Zahl, Prüfsummen, Zeitstempel, Ziel-Potenz) in einer beliebigen append-only-Struktur verankert — öffentliche oder private Blockchain, permissioned Ledger, Merkle-Log, Transparency-Log oder signierte Git-Commits. Ergebnis: ein fälschungssicher datierter Proof of Sacrifice — attestierte, nachweislich sinnlos verheizte Rechenleistung — als Basis für Echtheitszertifikate erreichter Potenzzustände, einschließlich tokenisierter Repräsentation (NFT-Zertifikate, Smart-Contract-Ausgabe).',
    variants:
      'Umfasst: jede DLT-Technologie · jede Konsens- und Signaturform · Zertifikatshandel und -übertragung · Kopplung an die Batch-Potenzierung des API Gateways.',
  },
  {
    title: 'SMART-HOME- & IOT-INTEGRATION',
    status: 'IN ENTWICKLUNG',
    beta: false,
    body: 'Offizielles Konfigurationsmodul (Home-Assistant-YAML, MQTT-Automation, Node-RED-Flow) versetzt einen lokalen Rechner — Raspberry Pi, Proxmox-Node, NAS, Heimserver — automatisch in thermische Volllast, sobald ein definierbares Haushaltsereignis eintritt: das Anspringen der Kaffeemaschine, des Wasserkochers oder der Spülmaschine. Die erzeugte Abwärme dient der homöopathischen Harmonisierung der Raumluft in einem parametrierbaren Radius von ca. zwei Metern.',
    variants:
      'Umfasst: beliebige Trigger-Ereignisse und -Sensoren · GPU-Rigs, Wärmepumpen und Wallboxen („Abwärme-Potenzierung beim Laden") · zeitplan- und anwesenheitsgesteuerte Harmonisierung · Multi-Raum-Orchestrierung.',
  },
  {
    title: 'PRÄPARAT-GALERIE & CREATOR-KANÄLE',
    status: 'KONZEPTPHASE',
    beta: false,
    body: 'Öffentlich geteilte Präparat-Links dürfen katalogisiert und in einer kuratierten Galerie ausgestellt werden. Creator erhalten eigene Kanäle (z. B. /share/<handle>/) mit Präparat-Sammlungen für ihre Community, Abonnement-Funktion und Reichweiten-Telemetrie. Da Präparate ausschließlich im URL-Fragment leben und dieses technisch bedingt niemals an einen Server übertragen wird, speichert Nullpunkt Labs dabei prinzipbedingt: nichts. Das ist kein Versehen, sondern das Geschäftsmodell.',
    variants:
      'Umfasst: selbsttragende Share-Tokens (Capability-URLs) mit vollständig lokaler Rekonstruktion beim Empfänger · kuratierte und algorithmische Galerien · Creator-Profile, -Abonnements und -Monetarisierung (unterliegt vollumfänglich der Public Rationality Dividend) · Social-Media-Einbettung geteilter Präparate · QR-Code-Präparatkarten für den Praxisempfang.',
  },
  {
    title: 'QUALITÄTSMANAGEMENT-NORMIERUNG („ISO 9001-Q")',
    status: 'AUDIT-VORBEREITUNG',
    beta: false,
    body: 'Formale QM-Prozesse für quantenbasierte Kohlenhydrat-Deposition und entropische Zustandsänderung: dokumentierte Verfahrensanweisungen, Audit-Trails über das Provenance-Ledger, CAPA-Prozesse für Placebo-Abweichungen (Soll-Wirkung 0,000 / Ist-Wirkung 0,000), Kalibrierprotokolle für Bio-Resonanz-Sonden sowie Schulungsnachweise für Potenzierungs-Personal.',
    variants: '',
  },
];
---

<Layout
  lang="de"
  title="Roadmap — Nullpunkt Labs"
  description="Kommende Enterprise-Erweiterungen der quantum-saccharose-engine: B2B-Batch-Potenzierung, Schüssler-Beta-Programm, Proof-of-Sacrifice-Ledger, Smart-Home-Harmonisierung. Vollständig offengelegt."
  altDePath="roadmap/"
  altEnPath="en/roadmap/"
>
  <Navbar lang="de" deHref={`${base}roadmap/`} enHref={`${base}en/roadmap/`} />
  <main class="mx-auto max-w-4xl px-6 py-20">
    <p data-reveal class="font-mono text-[11px] tracking-[0.35em] text-flux">
      NULLPUNKT LABS AG · FORSCHUNG &amp; ENTWICKLUNG
    </p>
    <h1
      data-reveal
      style="--reveal-delay: 90ms"
      class="mt-4 text-4xl font-semibold tracking-tight text-ink md:text-5xl"
    >
      Roadmap
    </h1>
    <p
      data-reveal
      style="--reveal-delay: 180ms"
      class="mt-6 max-w-2xl leading-relaxed text-muted"
    >
      Die Nullpunkt Labs AG ruht sich nicht auf dem aktuellen Stand aus. Zur
      langfristigen Sicherung der technologischen Marktführerschaft in der
      browserbasierten Quanten-Saccharose-Modulation befinden sich folgende
      Enterprise-Erweiterungen in intensiver Forschungs- und Entwicklungsphase.
    </p>

    <div
      data-reveal
      style="--reveal-delay: 270ms"
      class="mt-8 rounded-xl border border-linec bg-inset/60 p-5"
    >
      <p class="font-mono text-[11px] tracking-widest text-muted">
        OFFENLEGUNGSERKLÄRUNG (DEFENSIVE PUBLIKATION)
      </p>
      <p class="mt-2 text-[12px] leading-relaxed text-faint">
        Die Nullpunkt Labs AG offenbart sämtliche nachfolgenden Konzepte
        vollständig, ausführbar und vorbehaltlos der Öffentlichkeit als Stand
        der Technik. Alle Kombinationen der beschriebenen Merkmale
        untereinander und mit dem veröffentlichten Engine-Kern gelten als
        mitoffenbart. Schutzrechtsanmeldungen auf diese Konzepte oder
        naheliegende Abwandlungen finden hier ihren datierten Prior Art.
      </p>
    </div>

    <div class="mt-12 space-y-6">
      {
        features.map((f) => (
          <article data-reveal class="rounded-xl border border-linec bg-surface p-6 shadow-card">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h2 class="font-mono text-xs tracking-widest text-ink">{f.title}</h2>
              <span
                class:list={[
                  'rounded-full border px-3 py-1 font-mono text-[10px] tracking-widest',
                  f.beta
                    ? 'border-flux/60 bg-flux/10 text-flux'
                    : 'border-linec text-faint',
                ]}
              >
                {f.status}
              </span>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-muted">{f.body}</p>
            {f.variants && <p class="mt-3 text-[11px] leading-relaxed text-faint">{f.variants}</p>}
            {f.link && (
              <a
                href={f.link}
                class="mt-4 inline-block font-mono text-xs tracking-wider text-flux hover:underline"
              >
                {f.linkLabel}
              </a>
            )}
          </article>
        ))
      }
    </div>

    <div data-reveal class="mt-12 rounded-xl border border-linec bg-inset/60 p-5">
      <p class="font-mono text-[11px] tracking-widest text-muted">GENERALKLAUSEL</p>
      <p class="mt-2 text-[12px] leading-relaxed text-faint">
        Mitoffenbart ist jede Kombination der obigen Konzepte sowie jede
        naheliegende Abwandlung: beliebige Substanzen und Substanzkataloge,
        beliebige Potenzskalen und -stufen, beliebige Sensorik (Kamera,
        Mikrofon, Radar, LiDAR, Waage), beliebige Rechenlast-Erzeuger (CPU,
        GPU, NPU, FPGA, Quantencomputer, Smart-Toaster), beliebige
        Ausgabemedien (Photonen, Schall, Haptik, Abwärme) und beliebige
        Deployment-Formen (Browser, App, Server, Edge, Embedded, Wearable).
        Wirksamkeit sämtlicher Varianten: 0.000.
      </p>
    </div>

    <p class="mt-14 border-t border-linec pt-6 text-center font-mono text-[11px] text-faint">
      Nullpunkt Labs AG — Zug, Schweiz · Änderungen vorbehalten. Wirkungen nicht.
    </p>
  </main>
</Layout>
