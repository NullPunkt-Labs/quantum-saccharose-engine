---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<Layout
  lang="de"
  title="Über uns — Nullpunkt Labs AG"
  description="Die Nullpunkt Labs AG mit Sitz in Zug (Schweiz): führend an der Schnittstelle von digitaler Hochleistungs-Informatik, photonischer Bio-Resonanz und klassischer Saccharose-Veredelung."
  altDePath="ueber-uns/"
  altEnPath="en/about/"
>
  <Navbar lang="de" deHref={`${base}ueber-uns/`} enHref={`${base}en/about/`} />
  <main class="mx-auto max-w-4xl px-6 py-20">
    <p data-reveal class="font-mono text-[11px] tracking-[0.35em] text-flux">
      NULLPUNKT LABS AG · ZUG (SCHWEIZ)
    </p>
    <h1
      data-reveal
      style="--reveal-delay: 90ms"
      class="mt-4 text-4xl font-semibold tracking-tight text-ink md:text-5xl"
    >
      Über uns
    </h1>
    <blockquote
      data-reveal
      style="--reveal-delay: 180ms"
      class="mt-6 border-l-2 border-flux/60 pl-4 text-lg italic text-muted"
    >
      „Aus der Wiege der alpinen Vakuum-Quantenmechanik direkt in Ihren CPU-Cache."
    </blockquote>

    <section data-reveal class="mt-14">
      <h2 class="text-2xl font-semibold tracking-tight text-ink">Wer wir sind</h2>
      <p class="mt-4 leading-relaxed text-muted">
        Die Nullpunkt Labs AG mit Sitz im steueroptimierten Zug (Schweiz) ist ein führendes
        Technologieunternehmen an der Schnittstelle von digitaler Hochleistungs-Informatik,
        photonischer Bio-Resonanz und klassischer Saccharose-Veredelung. Seit unserer
        Ausgründung im Jahr 2024 entwickeln wir enterprise-feste Software-Architekturen, die
        dort ansetzen, wo herkömmliche Physik aufhört.
      </p>
      <p class="mt-4 leading-relaxed text-muted">
        In einer Welt, in der Rechenleistung rein materiell verpufft, haben wir es uns zur
        Aufgabe gemacht, ungenutzte thermische Ressourcen von Mikroprozessoren in echten,
        quanten-homöopathischen Mehrwert zu transformieren.
      </p>
    </section>

    <section data-reveal class="mt-14">
      <h2 class="text-2xl font-semibold tracking-tight text-ink">Unsere Kernkompetenzen</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        <div class="rounded border border-linec bg-surface p-5 shadow-card">
          <h3 class="font-mono text-xs tracking-widest text-flux">
            SUBATOMARE MONTE-CARLO-SIMULATIONEN
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Unsere proprietären Algorithmen berechnen Vakuumfluktuationen mit einer
            Präzision, die selbst den anspruchsvollsten Bachblüten-Extrakt vor Neid
            erblassen lässt.
          </p>
        </div>
        <div class="rounded border border-linec bg-surface p-5 shadow-card">
          <h3 class="font-mono text-xs tracking-widest text-flux">
            KLINISCHE STRENGE IM ENTERPRISE-SEGMENT
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Jedes unserer Software-Module entspricht strengen, selbst auferlegten
            ISO-Richtlinien für den berührungslosen Placebo-Transfer.
          </p>
        </div>
        <div class="rounded border border-linec bg-surface p-5 shadow-card">
          <h3 class="font-mono text-xs tracking-widest text-flux">
            DEZENTRALE BIO-FELD-INFRASTRUKTUR
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Durch die konsequente Nutzung lokaler Hardware-Ressourcen (unter anderem durch
            gezielte, hörbare Vollauslastung Ihrer CPU-Kerne) garantieren wir absolute
            Latenzfreiheit bei der Potenzierung.
          </p>
        </div>
      </div>
    </section>

    <section data-reveal class="mt-14">
      <h2 class="text-2xl font-semibold tracking-tight text-ink">
        Unser Leitbild (Mission Statement)
      </h2>
      <blockquote
        class="mt-6 rounded border border-linec bg-inset/60 p-6 text-center font-mono text-sm tracking-wider text-ink"
      >
        „Keine Cloud. Keine Uploads. Nur reines Silizium und reiner Zucker."
      </blockquote>
      <p class="mt-4 leading-relaxed text-muted">
        Wir glauben an die Souveränität des lokalen Rechenzentrums. Während internationale
        Konzerne Ihre Daten in undurchsichtigen Clouds speichern, bleiben Ihre photonischen
        Reflexionen bei Nullpunkt Labs exakt da, wo sie hingehören: lokal im Cache, bis der
        Lüfter glüht.
      </p>
    </section>

    <section data-reveal class="mt-14">
      <h2 class="text-2xl font-semibold tracking-tight text-ink">
        Vorstand &amp; Wissenschaftlicher Beirat
      </h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <div class="rounded border border-linec bg-surface p-5 shadow-card">
          <p class="font-semibold text-ink">Dr. med. h.c. Urs Schwyzer</p>
          <p class="font-mono text-[11px] tracking-widest text-flux">CHIEF QUANTUM OFFICER</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Pionier auf dem Gebiet der digitalen Globuli-Synthese und ehemaliger
            Chefentwickler für High-End-Praxisfolien.
          </p>
        </div>
        <div class="rounded border border-linec bg-surface p-5 shadow-card">
          <p class="font-semibold text-ink">Beatrix Läubli-Matter</p>
          <p class="font-mono text-[11px] tracking-widest text-flux">
            HEAD OF COMPLIANCE &amp; BIO-CHECK
          </p>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Verantwortlich für die lückenlose Überprüfung aller DIN EN ISO 17025-konformen
            Homöopathie-Halbzyklen.
          </p>
        </div>
      </div>
    </section>

    <p class="mt-14 border-t border-linec pt-6 text-center font-mono text-[11px] text-faint">
      Nullpunkt Labs AG — Zug, Schweiz · Alle Rechte vorbehalten. Photonenströme verlassen
      niemals das Gerät.
    </p>
  </main>
</Layout>
