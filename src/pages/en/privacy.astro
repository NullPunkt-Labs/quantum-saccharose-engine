---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const sections = [
  {
    title: '1. Controller',
    body: 'Nullpunkt Labs AG, Zug (Switzerland) — a satirical art project. Contact via the GitHub repository NullPunkt-Labs/quantum-saccharose-engine.',
  },
  {
    title: '2. What we collect: nothing',
    body: 'This website runs no tracking, sets no cookies, loads no analytics, no ad networks, no external fonts, and no third-party scripts. There is no server of our own, no database, and no login. We could not store your data even if we wanted to — and we do not want to.',
  },
  {
    title: '3. Webcam (bio-resonance probe)',
    body: 'Camera access is strictly opt-in and processed exclusively in your browser. The video stream never leaves your device at any point: no uploads, no storage, no transmission. The "analysis" is a locally computed, documentedly meaningless pixel checksum. Disconnecting the probe or closing the tab ends the stream.',
  },
  {
    title: '4. Local storage (localStorage)',
    body: 'Your browser locally stores: your theme choice (field polarity), your local preparation gallery, and the dose quotas of shared links (client-side DRM). This data lives exclusively on your device, is neither read nor transmitted by us, and can be deleted at any time via your browser settings. Preparation links themselves carry their data in the URL fragment — which, by technical necessity, is never transmitted to any web server.',
  },
  {
    title: '5. Hosting (GitHub Pages)',
    body: 'This website is served by GitHub Pages (GitHub, Inc., USA). When pages are requested, GitHub necessarily receives visitors’ IP addresses and stores them in server logs for security purposes (abuse protection, DDoS mitigation). We have no influence on this processing; details are governed by the GitHub Privacy Statement (https://docs.github.com/site-policy/privacy-policies/github-privacy-statement). This is the only point in this statement where any data flows at all — and it is not ours.',
  },
  {
    title: '6. Your rights',
    body: 'Since we process no personal data, requests for access, rectification, or erasure directed at us come to nothing — there is nothing we could disclose. For the hosting server logs, please contact GitHub. Your local storage is yours; delete it as you please. Your photon streams even more so.',
  },
];
---

<Layout
  lang="en"
  title="Privacy Policy — Nullpunkt Labs"
  description="Privacy at the quantum-saccharose-engine: we collect nothing. No tracking, no cookies, no server. GitHub Pages as host logs IP addresses for security purposes."
  altDePath="datenschutz/"
  altEnPath="en/privacy/"
>
  <Navbar lang="en" deHref={`${base}datenschutz/`} enHref={`${base}en/privacy/`} />
  <main class="mx-auto max-w-4xl px-6 py-20">
    <p data-reveal class="font-mono text-[11px] tracking-[0.35em] text-flux">
      NULLPUNKT LABS AG · COMPLIANCE &amp; BIO-CHECK
    </p>
    <h1
      data-reveal
      style="--reveal-delay: 90ms"
      class="mt-4 text-4xl font-semibold tracking-tight text-ink md:text-5xl"
    >
      Privacy Policy
    </h1>
    <p
      data-reveal
      style="--reveal-delay: 180ms"
      class="mt-6 max-w-2xl leading-relaxed text-muted"
    >
      The shortest privacy policy in the industry would be: "We have no
      data." For completeness — reviewed by our Head of Compliance &amp;
      Bio-Check — here is the long version.
    </p>

    <div class="mt-12 space-y-6">
      {
        sections.map((s) => (
          <section data-reveal class="rounded-xl border border-linec bg-surface p-6 shadow-card">
            <h2 class="font-mono text-xs tracking-widest text-ink">{s.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted">{s.body}</p>
          </section>
        ))
      }
    </div>

    <p class="mt-14 border-t border-linec pt-6 text-center font-mono text-[11px] text-faint">
      Last updated: August 2026 · Personal data collected since launch: 0.000
    </p>
  </main>
</Layout>
