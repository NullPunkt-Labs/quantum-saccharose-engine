---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const features = [
  {
    title: 'B2B ENTERPRISE API GATEWAY',
    status: 'CONCEPT PHASE',
    beta: false,
    body: 'Standardized interface (REST, GraphQL, gRPC, MQTT, OPC-UA, or any other protocol) for industrial bakeries, mills, sugar refineries, and pharmaceutical logistics. A sensor data stream — camera image, barcode/RFID, weight, temperature, or humidity sensor — represents the substance batch on the running conveyor; from it, a deliberately meaningless checksum is computed, the potentiation of the batch is declared, and a signed certificate (substance, potency level, timestamp, checksum) is returned, including webhooks to ERP and inventory systems.',
    variants:
      'Covers: cloud, on-premise, and edge deployment · single-item and batch potentiation · arbitrary sensors · machine-readable seals and QR codes on packaging.',
  },
  {
    title: 'BIOCHEMICAL BETA PROGRAM (SCHÜSSLER SALTS)',
    status: 'BETA — IN EARLY ACCESS NOW',
    beta: true,
    body: 'Extension of the substance library with the complete function and supplement remedies after Dr. Wilhelm Heinrich Schüssler (No. 1 Calcium fluoratum through No. 27 Kalium bichromicum), plus arbitrary further nosode, complex remedy, and Bach flower catalogs, each with freely selectable potency on any scale (D, C, LM/Q, Korsakoff). In preparation: haptic resonance simulation — a vibration pattern derived from the substance checksum, delivered via the haptics of any device.',
    variants:
      'Covers: arbitrary substance catalogs · haptic, acoustic ("sound potentiation"), and optical output channels · coupling of multiple devices into a resonance network.',
    link: `${base}en/#bibliothek`,
    linkLabel: 'Try it in early access now →',
  },
  {
    title: 'DISTRIBUTED LEDGER PROVENANCE (PROOF OF SACRIFICE)',
    status: 'IN DEVELOPMENT',
    beta: false,
    body: 'Every completed compute phase of the energetic proof of work is anchored as a hash of its telemetry (chunk count, checksums, timestamps, target potency) in any append-only structure — public or private blockchain, permissioned ledger, Merkle log, transparency log, or signed git commits. The result: a tamper-proof, dated proof of sacrifice — attested, demonstrably pointless burned compute — as the basis for authenticity certificates of achieved potency states, including tokenized representation (NFT certificates, smart contract issuance).',
    variants:
      'Covers: any DLT technology · any consensus and signature scheme · certificate trading and transfer · coupling with the API gateway batch potentiation.',
  },
  {
    title: 'SMART HOME & IOT INTEGRATION',
    status: 'IN DEVELOPMENT',
    beta: false,
    body: 'Official configuration module (Home Assistant YAML, MQTT automation, Node-RED flow) automatically puts a local machine — Raspberry Pi, Proxmox node, NAS, home server — under full thermal load whenever a definable household event occurs: the coffee machine, kettle, or dishwasher starting up. The generated waste heat serves the homeopathic harmonization of the room air within a configurable radius of roughly two meters.',
    variants:
      'Covers: arbitrary trigger events and sensors · GPU rigs, heat pumps, and EV wallboxes ("waste-heat potentiation while charging") · schedule- and presence-controlled harmonization · multi-room orchestration.',
  },
  {
    title: 'PREPARATION GALLERY & CREATOR CHANNELS',
    status: 'CONCEPT PHASE',
    beta: false,
    body: 'Publicly shared preparation links may be cataloged and exhibited in a curated gallery. Creators receive their own channels (e.g. /share/<handle>/) with preparation collections for their community, subscription features, and reach telemetry. Since preparations live exclusively in the URL fragment — which, by technical necessity, is never transmitted to any server — Nullpunkt Labs stores, as a matter of principle: nothing. This is not an oversight; it is the business model.',
    variants:
      'Covers: self-carrying share tokens (capability URLs) with fully local reconstruction at the recipient · curated and algorithmic galleries · creator profiles, subscriptions, and monetization (fully subject to the Public Rationality Dividend) · social media embedding of shared preparations · QR-code preparation cards for the practice reception desk.',
  },
  {
    title: 'DEFLATIONARY TOKENOMICS & CLIENT-SIDE DRM FOR ZERO-EFFICACY ASSETS',
    status: 'JUST SHIPPED',
    beta: true,
    body: 'Every shared preparation link carries a deflationary dose quota of 4 potentiations. Enforcement is pure client-side DRM on the recipient’s device (localStorage) — fully serverless, fully stateless, fully bypassable. Clearing the browser storage restores the quota; this is documented behavior and is internally filed as quantum tunneling. Scarcity, like efficacy, is thus purely a matter of faith.',
    variants:
      'Covers: arbitrary quota sizes and decay models (half-life, subscription refresh) · transferable and tradeable dose quotas · coupling to the proof-of-sacrifice ledger for "binding" scarcity · QR-code redemption cards with remaining-dose display.',
  },
  {
    title: 'HARMONIZER-5G (EDGE APPLIANCE)',
    status: 'COMING SOON',
    beta: false,
    body: 'Electrosmog harmonization as a standalone product: a scanning module (Web Bluetooth, Wi-Fi environment analysis, or any other radio sensing) counts radiation sources in the vicinity; harmonization is performed by continuously emitting phase-inverted silence — by design, the system transmits exactly nothing, thereby achieving full efficacy parity with the established harmonization-chip competition, just honestly documented. Telemetry: DETECTED RADIATION SOURCES: n · HARMONIZED: n · CHANGE: 0.000. Shipped as a browser application and as a containerized Node.js service (Docker/OCI) for edge hardware — from Raspberry Pi to retired thin clients: your Raspi. Against 5G. Around the clock.',
    variants:
      'Covers: arbitrary single-board computers and container runtimes (Docker, Podman, Kubernetes, Home Assistant add-on) · MQTT status topics and calming LED ring · PoE-powered harmonization appliances for reception areas · subscription models for "harmonization zones" (subject to the Public Rationality Dividend) · QR pairing with the preparation gallery.',
  },
  {
    title: 'QUALITY MANAGEMENT STANDARDIZATION ("ISO 9001-Q")',
    status: 'AUDIT PREPARATION',
    beta: false,
    body: 'Formal QM processes for quantum-based carbohydrate deposition and entropic state change: documented procedures, audit trails via the provenance ledger, CAPA processes for placebo deviations (target efficacy 0.000 / actual efficacy 0.000), calibration protocols for bio-resonance probes, and training records for potentiation personnel.',
    variants: '',
  },
];
---

<Layout
  lang="en"
  title="Roadmap — Nullpunkt Labs"
  description="Upcoming enterprise extensions of the quantum-saccharose-engine: B2B batch potentiation, Schüssler beta program, proof-of-sacrifice ledger, smart home harmonization. Fully disclosed."
  altDePath="roadmap/"
  altEnPath="en/roadmap/"
>
  <Navbar lang="en" deHref={`${base}roadmap/`} enHref={`${base}en/roadmap/`} />
  <main class="mx-auto max-w-4xl px-6 py-20">
    <p data-reveal class="font-mono text-[11px] tracking-[0.35em] text-flux">
      NULLPUNKT LABS AG · RESEARCH &amp; DEVELOPMENT
    </p>
    <h1
      data-reveal
      style="--reveal-delay: 90ms"
      class="mt-4 text-4xl font-semibold tracking-tight text-ink md:text-5xl"
    >
      Roadmap
    </h1>
    <p
      data-reveal
      style="--reveal-delay: 180ms"
      class="mt-6 max-w-2xl leading-relaxed text-muted"
    >
      Nullpunkt Labs AG does not rest on the current state of the art. To
      secure long-term technological market leadership in browser-based
      quantum saccharose modulation, the following enterprise extensions are
      in an intensive research and development phase.
    </p>

    <div
      data-reveal
      style="--reveal-delay: 270ms"
      class="mt-8 rounded-xl border border-linec bg-inset/60 p-5"
    >
      <p class="font-mono text-[11px] tracking-widest text-muted">
        DISCLOSURE STATEMENT (DEFENSIVE PUBLICATION)
      </p>
      <p class="mt-2 text-[12px] leading-relaxed text-faint">
        Nullpunkt Labs AG discloses all of the following concepts completely,
        in enabling detail, and unconditionally to the public as state of the
        art. All combinations of the described features with one another and
        with the published engine core are considered disclosed as well. Any
        IP filing on these concepts or obvious variations thereof will find
        its dated prior art right here.
      </p>
    </div>

    <div class="mt-12 space-y-6">
      {
        features.map((f) => (
          <article data-reveal class="rounded-xl border border-linec bg-surface p-6 shadow-card">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h2 class="font-mono text-xs tracking-widest text-ink">{f.title}</h2>
              <span
                class:list={[
                  'rounded-full border px-3 py-1 font-mono text-[10px] tracking-widest',
                  f.beta
                    ? 'border-flux/60 bg-flux/10 text-flux'
                    : 'border-linec text-faint',
                ]}
              >
                {f.status}
              </span>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-muted">{f.body}</p>
            {f.variants && <p class="mt-3 text-[11px] leading-relaxed text-faint">{f.variants}</p>}
            {f.link && (
              <a
                href={f.link}
                class="mt-4 inline-block font-mono text-xs tracking-wider text-flux hover:underline"
              >
                {f.linkLabel}
              </a>
            )}
          </article>
        ))
      }
    </div>

    <div data-reveal class="mt-12 rounded-xl border border-linec bg-inset/60 p-5">
      <p class="font-mono text-[11px] tracking-widest text-muted">CATCH-ALL CLAUSE</p>
      <p class="mt-2 text-[12px] leading-relaxed text-faint">
        Also disclosed is every combination of the above concepts and every
        obvious variation thereof: arbitrary substances and substance
        catalogs, arbitrary potency scales and levels, arbitrary sensors
        (camera, microphone, radar, LiDAR, scale), arbitrary compute-load
        generators (CPU, GPU, NPU, FPGA, quantum computer, smart toaster),
        arbitrary output media (photons, sound, haptics, waste heat), and
        arbitrary deployment forms (browser, app, server, edge, embedded,
        wearable). Efficacy of all variants: 0.000.
      </p>
    </div>

    <p class="mt-14 border-t border-linec pt-6 text-center font-mono text-[11px] text-faint">
      Nullpunkt Labs AG — Zug, Switzerland · Subject to change. Effects are not.
    </p>
  </main>
</Layout>
