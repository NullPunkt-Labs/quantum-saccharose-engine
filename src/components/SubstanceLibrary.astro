---
import { translations, type Lang } from '../i18n/translations';
import { GLOBULI, SCHUESSLER, POTENCIES, DEFAULT_POTENCY } from '../data/globuli';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;
const t = translations[lang];
---

<section id="bibliothek" class="scroll-mt-14 border-t border-linec bg-inset/40">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
    <div class="text-center">
      <p data-reveal class="font-mono text-[11px] tracking-[0.35em] text-flux">
        {t.library.eyebrow}
      </p>
      <h2
        data-reveal
        style="--reveal-delay: 90ms"
        class="mx-auto mt-6 max-w-3xl text-3xl font-semibold leading-tight tracking-tight text-ink md:text-5xl"
      >
        {t.library.h2}
      </h2>
      <p
        data-reveal
        style="--reveal-delay: 180ms"
        class="mx-auto mt-6 max-w-2xl leading-relaxed text-muted"
      >
        {t.library.body}
      </p>
    </div>

    <div
      data-reveal
      style="--reveal-delay: 270ms"
      class="mx-auto mt-14 max-w-3xl rounded-xl border border-linec bg-surface p-6 shadow-card"
    >
      <div class="grid gap-6 md:grid-cols-2">
        <label class="block">
          <span class="font-mono text-[11px] tracking-widest text-faint">
            {t.library.substanceLabel}
          </span>
          <select
            id="lib-select"
            class="mt-2 w-full rounded-lg border border-linec bg-page px-3 py-2.5 font-mono text-sm text-ink focus:border-flux/60 focus:outline-none"
          >
            <option value="__custom" selected>{t.library.customOption}</option>
            <optgroup label={t.library.groupClassic}>
              {GLOBULI.map((g) => <option value={g}>{g}</option>)}
            </optgroup>
            <optgroup id="lib-beta-group" label={t.library.groupBeta}>
              {SCHUESSLER.map((s) => <option value={s}>{s}</option>)}
            </optgroup>
          </select>
        </label>
        <div>
          <span class="font-mono text-[11px] tracking-widest text-faint">
            {t.library.potencyLabel}
          </span>
          <div id="lib-potencies" class="mt-2 flex flex-wrap gap-2">
            {
              POTENCIES.map((p) => (
                <button
                  type="button"
                  data-potency={p}
                  class:list={[
                    'rounded-full border px-4 py-2 font-mono text-xs tracking-wider transition',
                    p === DEFAULT_POTENCY
                      ? 'border-flux/60 bg-flux/10 text-flux'
                      : 'border-linec text-muted hover:border-flux/40 hover:text-flux',
                  ]}
                >
                  {p}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <label
        class="mt-6 flex cursor-pointer items-start gap-3 rounded-lg border border-linec bg-inset/60 px-4 py-3"
      >
        <input type="checkbox" id="lib-beta" class="mt-0.5 h-4 w-4 accent-flux" />
        <span class="text-[11px] leading-relaxed text-muted">{t.library.betaLabel}</span>
      </label>

      <p
        id="lib-readout"
        class="mt-4 rounded-lg border border-linec bg-inset/60 px-4 py-3 font-mono text-[11px] leading-relaxed text-muted"
      >
        {t.library.readoutIdle}
      </p>
      <p class="mt-3 text-[10px] leading-relaxed text-faint/80">{t.library.note}</p>
    </div>
  </div>
</section>

<script>
  const STRINGS = {
    de: {
      loaded: (n, p) =>
        `AKTIVE MATRIX: ${n} · ${p} — Referenz-Spektrum geladen, Kalibrierung übersprungen.`,
      custom: (p) =>
        `AKTIVE MATRIX: Eigene Substanz · ${p} — Kalibrierung über Subsystem 01 erforderlich.`,
    },
    en: {
      loaded: (n, p) =>
        `ACTIVE MATRIX: ${n} · ${p} — reference spectrum loaded, calibration skipped.`,
      custom: (p) => `ACTIVE MATRIX: Own substance · ${p} — calibration via subsystem 01 required.`,
    },
  };
  const L = STRINGS[document.documentElement.lang === 'en' ? 'en' : 'de'];

  const select = document.getElementById('lib-select');
  const readout = document.getElementById('lib-readout');
  const potencyBtns = document.querySelectorAll('#lib-potencies [data-potency]');
  const betaToggle = document.getElementById('lib-beta');
  const betaGroup = document.getElementById('lib-beta-group');
  let potency = 'D30';

  // The beta program stays invisible until early access is activated.
  // Without JavaScript, everyone is a beta tester — a known upstream feature.
  betaGroup.remove();
  betaToggle.addEventListener('change', () => {
    if (betaToggle.checked) {
      select.appendChild(betaGroup);
    } else {
      const betaValues = Array.from(betaGroup.querySelectorAll('option'), (o) => o.value);
      if (betaValues.includes(select.value)) {
        select.value = '__custom';
        announce();
      }
      betaGroup.remove();
    }
  });

  function announce() {
    const custom = select.value === '__custom';
    const name = custom ? null : select.value;
    document.dispatchEvent(
      new CustomEvent('qse:substance', { detail: { name, custom, potency } })
    );
    if (custom) {
      readout.textContent = L.custom(potency);
    } else {
      readout.textContent = L.loaded(name, potency);
      // A library reference counts as a valid calibration. Obviously.
      document.documentElement.dataset.qseCalibrated = '1';
      document.dispatchEvent(new CustomEvent('qse:calibrated'));
    }
  }

  select.addEventListener('change', announce);
  potencyBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      potency = btn.getAttribute('data-potency');
      potencyBtns.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('border-flux/60', active);
        b.classList.toggle('bg-flux/10', active);
        b.classList.toggle('text-flux', active);
        b.classList.toggle('border-linec', !active);
        b.classList.toggle('text-muted', !active);
      });
      announce();
    });
  });
</script>
