---
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;
const t = translations[lang];
---

<section id="bio-sonde" class="scroll-mt-14 border-t border-linec bg-inset/40">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
    <div class="text-center">
      <p data-reveal class="font-mono text-[11px] tracking-[0.35em] text-flux">
        {t.scanner.eyebrow}
      </p>
      <h2
        data-reveal
        style="--reveal-delay: 90ms"
        class="mx-auto mt-6 max-w-3xl text-3xl font-semibold leading-tight tracking-tight text-ink md:text-5xl"
      >
        {t.scanner.h2}
      </h2>
      <p
        data-reveal
        style="--reveal-delay: 180ms"
        class="mx-auto mt-6 max-w-2xl leading-relaxed text-muted"
      >
        {t.scanner.body}
      </p>
    </div>

    <div data-reveal style="--reveal-delay: 270ms" class="mt-14 grid gap-6 lg:grid-cols-[3fr,2fr]">
      <div
        class="relative aspect-[4/3] overflow-hidden rounded border border-linec bg-black shadow-card"
      >
        <video
          id="bio-video"
          playsinline
          muted
          class="absolute inset-0 h-full w-full object-cover"></video>
        <canvas id="bio-overlay" class="absolute inset-0 h-full w-full"></canvas>
        <div
          id="bio-idle"
          class="absolute inset-0 grid place-items-center bg-slate-950/95 font-mono text-xs tracking-widest text-slate-500"
        >
          {t.scanner.idle}
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <button
          id="bio-start"
          class="rounded border border-flux/60 bg-flux/10 px-5 py-3 text-left font-mono text-sm tracking-wider text-flux shadow-flux-glow transition hover:bg-flux/20"
        >
          {t.scanner.start}
        </button>
        <button
          id="bio-stop"
          disabled
          class="rounded border border-linec px-5 py-3 text-left font-mono text-sm tracking-wider text-faint transition enabled:border-ultraviolet/60 enabled:text-ink enabled:hover:bg-ultraviolet/10 disabled:cursor-not-allowed"
        >
          {t.scanner.stop}
        </button>

        <dl
          class="mt-2 space-y-2 rounded border border-linec bg-surface p-4 font-mono text-xs shadow-card"
        >
          <div class="flex justify-between gap-4">
            <dt class="text-faint">{t.scanner.labels.status}</dt>
            <dd id="bio-status" class="text-right text-muted">{t.scanner.standby}</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-faint">{t.scanner.labels.freq}</dt>
            <dd id="bio-freq" class="text-right text-ink">——— THz</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-faint">{t.scanner.labels.checksum}</dt>
            <dd id="bio-hex" class="text-right text-ink">0x00000000</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-faint">{t.scanner.labels.lock}</dt>
            <dd id="bio-lock" class="text-right text-muted">STANDBY</dd>
          </div>
        </dl>

        <p class="text-[11px] leading-relaxed text-faint">{t.scanner.privacy}</p>
      </div>
    </div>
  </div>
</section>

<script>
  const STRINGS = {
    de: {
      active: 'Resonanz aktiv — Substanz-Spektrum erkannt',
      blocked: 'Kamera blockiert — universelles Placebo-Spektrum geladen',
      standby: 'Standby',
    },
    en: {
      active: 'Resonance active — substance spectrum detected',
      blocked: 'Camera blocked — universal placebo spectrum loaded',
      standby: 'Standby',
    },
  };
  const L = STRINGS[document.documentElement.lang === 'en' ? 'en' : 'de'];

  const video = document.getElementById('bio-video');
  const overlay = document.getElementById('bio-overlay');
  const idle = document.getElementById('bio-idle');
  const startBtn = document.getElementById('bio-start');
  const stopBtn = document.getElementById('bio-stop');
  const statusEl = document.getElementById('bio-status');
  const freqEl = document.getElementById('bio-freq');
  const hexEl = document.getElementById('bio-hex');
  const lockEl = document.getElementById('bio-lock');

  const octx = overlay.getContext('2d');
  const sampler = document.createElement('canvas');
  sampler.width = 64;
  sampler.height = 48;
  const sctx = sampler.getContext('2d', { willReadFrequently: true });

  let stream = null;
  let rafId = 0;
  let sampleTimer = 0;
  let running = false;
  let synthetic = false;
  let tick = 0;
  let checksum = 0;
  let entropyIndex = 0;

  function resizeOverlay() {
    const dpr = window.devicePixelRatio || 1;
    overlay.width = overlay.clientWidth * dpr;
    overlay.height = overlay.clientHeight * dpr;
    octx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function drawOverlay() {
    if (!running) return;
    tick++;
    const w = overlay.clientWidth;
    const h = overlay.clientHeight;
    octx.clearRect(0, 0, w, h);

    // The sensor viewport keeps its instrument look in both themes.
    octx.strokeStyle = 'rgba(0, 240, 255, 0.08)';
    octx.lineWidth = 1;
    for (let x = 0; x < w; x += 32) {
      octx.beginPath();
      octx.moveTo(x, 0);
      octx.lineTo(x, h);
      octx.stroke();
    }
    for (let y = 0; y < h; y += 32) {
      octx.beginPath();
      octx.moveTo(0, y);
      octx.lineTo(w, y);
      octx.stroke();
    }

    // sweeping scanline
    const scanY = ((tick * 2.2) % (h + 60)) - 30;
    const grad = octx.createLinearGradient(0, scanY - 24, 0, scanY + 24);
    grad.addColorStop(0, 'rgba(0, 240, 255, 0)');
    grad.addColorStop(0.5, 'rgba(0, 240, 255, 0.16)');
    grad.addColorStop(1, 'rgba(0, 240, 255, 0)');
    octx.fillStyle = grad;
    octx.fillRect(0, scanY - 24, w, 48);

    // glitch bars
    if (tick % 7 === 0) {
      octx.fillStyle = 'rgba(255, 255, 255, 0.04)';
      octx.fillRect(0, Math.random() * h, w, 2 + Math.random() * 5);
    }

    // QUANTUM-LOCK bounding box (jittering around center)
    const jx = Math.sin(tick / 17) * 9 + (Math.random() - 0.5) * 4;
    const jy = Math.cos(tick / 23) * 7 + (Math.random() - 0.5) * 4;
    const bw = w * 0.44;
    const bh = h * 0.5;
    const bx = (w - bw) / 2 + jx;
    const by = (h - bh) / 2 + jy;
    const corner = 18;
    octx.strokeStyle = 'rgba(0, 240, 255, 0.85)';
    octx.lineWidth = 1.5;
    for (const [cx, cy, dx, dy] of [
      [bx, by, 1, 1],
      [bx + bw, by, -1, 1],
      [bx, by + bh, 1, -1],
      [bx + bw, by + bh, -1, -1],
    ]) {
      octx.beginPath();
      octx.moveTo(cx + dx * corner, cy);
      octx.lineTo(cx, cy);
      octx.lineTo(cx, cy + dy * corner);
      octx.stroke();
    }
    octx.font = '10px ui-monospace, monospace';
    octx.fillStyle = 'rgba(0, 240, 255, 0.9)';
    octx.fillText('QUANTUM-LOCK · D30', bx, by - 8);
    octx.fillStyle = 'rgba(150, 90, 255, 0.9)';
    octx.fillText(`ΔE ${(entropyIndex / 100).toFixed(4)} eV`, bx, by + bh + 16);

    // fluctuating hex + frequency readouts
    octx.fillStyle = 'rgba(230, 233, 238, 0.75)';
    octx.fillText(
      `0x${((checksum ^ (tick * 2654435761)) >>> 0).toString(16).padStart(8, '0').toUpperCase()}`,
      12,
      20
    );
    octx.fillText(
      `${(482.5 + Math.sin(tick / 29) * 0.8 + entropyIndex / 250).toFixed(3)} THz`,
      12,
      h - 14
    );
    octx.fillText(`FRAME ${String(tick).padStart(6, '0')}`, w - 90, 20);

    rafId = requestAnimationFrame(drawOverlay);
  }

  function sampleFrame() {
    if (!running) return;
    let colorSum = 0;
    if (synthetic) {
      // universal placebo spectrum: statistically indistinguishable from Bachblüten
      colorSum = Math.floor(Math.random() * 999999);
    } else {
      sctx.drawImage(video, 0, 0, sampler.width, sampler.height);
      const frame = sctx.getImageData(0, 0, sampler.width, sampler.height);
      // completely meaningless checksum to "prove" substance analysis
      for (let i = 0; i < frame.data.length; i += 4) {
        colorSum += frame.data[i] + frame.data[i + 1] + frame.data[i + 2];
      }
    }
    checksum = colorSum >>> 0;
    entropyIndex = (colorSum % 999) / 10.0;
    freqEl.textContent = `${entropyIndex.toFixed(2)} THz`;
    hexEl.textContent = `0x${checksum.toString(16).padStart(8, '0').toUpperCase()}`;
    lockEl.textContent = 'LOCKED';
    lockEl.classList.add('text-flux');
  }

  async function start() {
    startBtn.disabled = true;
    try {
      stream = await navigator.mediaDevices.getUserMedia({
        video: { width: 640, height: 480, facingMode: 'user' },
      });
      video.srcObject = stream;
      await video.play();
      synthetic = false;
      statusEl.textContent = L.active;
      console.info('[BIOCAM] Optical resonance link established. Bachblüten spectrum detected.');
    } catch (err) {
      synthetic = true;
      statusEl.textContent = L.blocked;
      console.warn('[BIOCAM] Camera blocked. Falling back to default universal placebo spectrum.');
    }
    running = true;
    idle.style.display = 'none';
    stopBtn.disabled = false;
    resizeOverlay();
    drawOverlay();
    sampleTimer = setInterval(sampleFrame, 500);

    // Subsystem interlock: calibration unlocks the Vacuum Potentiator.
    // The universal placebo spectrum counts — obviously.
    document.documentElement.dataset.qseCalibrated = '1';
    document.dispatchEvent(new CustomEvent('qse:calibrated'));
  }

  function stop() {
    running = false;
    cancelAnimationFrame(rafId);
    clearInterval(sampleTimer);
    if (stream) {
      stream.getTracks().forEach((t) => t.stop());
      stream = null;
    }
    video.srcObject = null;
    octx.clearRect(0, 0, overlay.clientWidth, overlay.clientHeight);
    idle.style.display = 'grid';
    statusEl.textContent = L.standby;
    freqEl.textContent = '——— THz';
    lockEl.textContent = 'STANDBY';
    lockEl.classList.remove('text-flux');
    startBtn.disabled = false;
    stopBtn.disabled = true;
  }

  startBtn.addEventListener('click', start);
  stopBtn.addEventListener('click', stop);
  window.addEventListener('resize', () => running && resizeOverlay());
  window.addEventListener('pagehide', stop);
</script>
