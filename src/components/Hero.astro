---
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;
const t = translations[lang];
---

<section id="top" class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0"
    style="background-image:
      linear-gradient(to right, var(--grid-color) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-color) 1px, transparent 1px);
      background-size: 48px 48px;
      mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 40%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 40%, transparent 100%);"
  >
  </div>
  <div
    class="pointer-events-none absolute -top-40 left-1/2 h-96 w-[42rem] -translate-x-1/2 rounded-full bg-ultraviolet/10 blur-3xl"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-6 pb-28 pt-28 text-center md:pb-36 md:pt-40">
    <p data-reveal class="font-mono text-[11px] tracking-[0.35em] text-flux">{t.hero.eyebrow}</p>
    <h1
      data-reveal
      style="--reveal-delay: 90ms"
      class="mx-auto mt-8 max-w-4xl text-5xl font-semibold leading-[1.05] tracking-tight text-ink md:text-7xl"
    >
      {t.hero.h1[0]}<br />
      {t.hero.h1[1]}<br />
      <span class="text-flux">{t.hero.h1[2]}</span>
    </h1>
    <p
      data-reveal
      style="--reveal-delay: 180ms"
      class="mx-auto mt-8 max-w-2xl text-base leading-relaxed text-muted md:text-lg"
    >
      {t.hero.sub}
    </p>

    <div
      data-reveal
      style="--reveal-delay: 270ms"
      class="mt-12 flex flex-wrap justify-center gap-4"
    >
      <a
        href="#bio-sonde"
        class="rounded-full border border-flux/60 bg-flux/10 px-8 py-3.5 font-mono text-sm tracking-wider text-flux shadow-flux-glow transition hover:bg-flux/20"
      >
        {t.hero.ctaScanner}
      </a>
      <a
        href="#engine"
        class="rounded-full border border-linec px-8 py-3.5 font-mono text-sm tracking-wider text-muted transition hover:border-ultraviolet/60 hover:text-ink"
      >
        {t.hero.ctaEngine}
      </a>
    </div>

    <dl
      data-reveal
      style="--reveal-delay: 360ms"
      class="mx-auto mt-24 grid max-w-3xl grid-cols-2 gap-px overflow-hidden rounded-xl border border-linec bg-linec font-mono text-xs shadow-card md:grid-cols-4"
    >
      {
        t.hero.stats.map((stat) => (
          <div class="bg-surface p-4">
            <dt class="text-faint">{stat.label}</dt>
            <dd class="mt-1 text-ink">{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
