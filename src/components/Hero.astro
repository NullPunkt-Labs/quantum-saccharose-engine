---
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;
const t = translations[lang];
---

<section id="top" class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.35]"
    style="background-image:
      linear-gradient(to right, rgba(58,64,75,0.25) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(58,64,75,0.25) 1px, transparent 1px);
      background-size: 48px 48px;"
  >
  </div>
  <div
    class="pointer-events-none absolute -top-40 left-1/2 h-96 w-[42rem] -translate-x-1/2 rounded-full bg-ultraviolet/10 blur-3xl"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-6 pb-24 pt-24 md:pt-32">
    <p class="font-mono text-[11px] tracking-[0.35em] text-flux/80">{t.hero.eyebrow}</p>
    <h1
      class="mt-6 max-w-3xl text-4xl font-semibold leading-tight tracking-tight text-void-100 md:text-6xl"
    >
      {t.hero.h1[0]}<br />
      {t.hero.h1[1]}<br />
      <span class="text-flux">{t.hero.h1[2]}</span>
    </h1>
    <p class="mt-8 max-w-2xl text-base leading-relaxed text-void-300 md:text-lg">
      {t.hero.sub}
    </p>

    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="#bio-sonde"
        class="rounded border border-flux/60 bg-flux/10 px-6 py-3 font-mono text-sm tracking-wider text-flux shadow-flux-glow transition hover:bg-flux/20"
      >
        {t.hero.ctaScanner}
      </a>
      <a
        href="#engine"
        class="rounded border border-void-700 px-6 py-3 font-mono text-sm tracking-wider text-void-300 transition hover:border-ultraviolet/60 hover:text-void-100"
      >
        {t.hero.ctaEngine}
      </a>
    </div>

    <dl
      class="mt-16 grid max-w-3xl grid-cols-2 gap-px overflow-hidden rounded border border-void-700 bg-void-700 font-mono text-xs md:grid-cols-4"
    >
      {
        t.hero.stats.map((stat) => (
          <div class="bg-void-900 p-4">
            <dt class="text-void-500">{stat.label}</dt>
            <dd class="mt-1 text-void-100">{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
