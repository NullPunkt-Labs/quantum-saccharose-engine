---
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;
const t = translations[lang];
---

<section id="engine" class="scroll-mt-14 border-t border-linec">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
    <div class="text-center">
      <p data-reveal class="font-mono text-[11px] tracking-[0.35em] text-ultraviolet">
        {t.engine.eyebrow}
      </p>
      <h2
        data-reveal
        style="--reveal-delay: 90ms"
        class="mx-auto mt-6 max-w-3xl text-3xl font-semibold leading-tight tracking-tight text-ink md:text-5xl"
      >
        {t.engine.h2}
      </h2>
      <p
        data-reveal
        style="--reveal-delay: 180ms"
        class="mx-auto mt-6 max-w-2xl leading-relaxed text-muted"
      >
        {t.engine.body}
      </p>
    </div>

    <div data-reveal style="--reveal-delay: 270ms" class="mt-14 grid gap-6 lg:grid-cols-[3fr,2fr]">
      <div class="relative overflow-hidden rounded border border-linec bg-inset shadow-card">
        <canvas id="q-canvas" class="block h-96 w-full"></canvas>
      </div>

      <div class="flex flex-col gap-4">
        <dl class="space-y-3 rounded border border-linec bg-surface p-5 font-mono text-xs shadow-card">
          <div class="flex justify-between gap-4">
            <dt class="text-faint">TARGET_MATRIX</dt>
            <dd id="q-target" class="max-w-[60%] truncate text-right text-ink">
              {t.engine.targetDefault}
            </dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-faint">PHOTON_FLUX</dt>
            <dd id="q-flux" class="text-ink">0 Γ·s⁻¹</dd>
          </div>
          <div>
            <div class="flex justify-between gap-4">
              <dt class="text-faint">ENTROPY_STATE</dt>
              <dd id="q-entropy" class="text-ink">{t.engine.standbyState}</dd>
            </div>
            <div class="mt-2 h-1 overflow-hidden rounded bg-inset">
              <div
                id="q-entropy-bar"
                class="h-full bg-gradient-to-r from-flux to-ultraviolet transition-all duration-500"
                style="width: 3%"
              >
              </div>
            </div>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-faint">CORE_LOAD</dt>
            <dd id="q-load" class="text-ink">3 %</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-faint">EFFICACY</dt>
            <dd class="text-faint">0.000</dd>
          </div>
        </dl>

        <button
          id="q-ignite"
          disabled
          class="rounded border border-linec px-5 py-4 font-mono text-sm tracking-wider text-faint transition enabled:border-flux/60 enabled:bg-flux/10 enabled:text-flux enabled:shadow-flux-glow enabled:hover:bg-flux/20 disabled:cursor-not-allowed"
        >
          {t.engine.ignite}
        </button>
        <button
          id="q-abort"
          disabled
          class="rounded border border-linec px-5 py-4 font-mono text-sm tracking-wider text-faint transition enabled:border-red-500/70 enabled:bg-red-500/10 enabled:text-red-600 dark:enabled:text-red-400 enabled:hover:bg-red-500/20 disabled:cursor-not-allowed"
        >
          {t.engine.abort}
        </button>

        <div id="q-consent" class="hidden rounded border border-linec bg-inset p-4 shadow-card">
          <p class="font-mono text-[11px] tracking-widest text-muted">{t.engine.consentTitle}</p>
          <p class="mt-2 text-[11px] leading-relaxed text-faint">{t.engine.consentBody}</p>
          <button
            id="q-consent-accept"
            class="mt-3 w-full rounded border border-linec bg-surface px-4 py-2 font-mono text-[11px] tracking-wider text-muted transition hover:border-flux/50 hover:text-flux"
          >
            {t.engine.consentAccept}
          </button>
        </div>

        <p id="q-status" class="font-mono text-[11px] leading-relaxed text-faint">
          {t.engine.locked}
        </p>

        <p
          class="rounded border border-amber-500/50 bg-amber-500/10 p-3 text-[11px] leading-relaxed text-amber-700 dark:bg-amber-500/5 dark:text-amber-200/80"
        >
          ⚠ {t.engine.warning}
        </p>

        <p class="text-[11px] leading-relaxed text-faint">{t.engine.note}</p>
        <p class="text-[10px] leading-relaxed text-faint/80">{t.engine.safety}</p>
      </div>
    </div>
  </div>
</section>

<script>
  const STRINGS = {
    de: {
      locked:
        'Gesperrt — Subsystem 01 (Bio-Feld-Kalibrierung) muss zuerst ausgeführt werden. Ohne Substanz-Spektrum keine Potenzierung.',
      readyCalibrated: 'Bio-Feld kalibriert. Bereit zur Feld-Modulation.',
      activeStatus: (n) =>
        `Feld-Modulation aktiv — ${n} Vakuum-Kanäle rechnen. Notaus jederzeit verfügbar.`,
      aborted: 'Potenzierung abgebrochen — Feld kontrolliert kollabiert.',
      halfCycleDone:
        'Homöopathischer Halbzyklus abgeschlossen — Potenzierung finalisiert. Saccharose-Molekulargedächtnis aktualisiert.',
      fieldNominal: 'FELD: NOMINAL',
      fieldModulating: 'FELD: MODULIEREND',
      potentiating: 'POTENZIERUNG',
      customSubstance: 'EIGENE SUBSTANZ',
      canvasLabel: 'FELD-MODULATION AKTIV',
      numberLocale: 'de-DE',
    },
    en: {
      locked:
        'Locked — subsystem 01 (bio-field calibration) must run first. No substance spectrum, no potentiation.',
      readyCalibrated: 'Bio-field calibrated. Ready for field modulation.',
      activeStatus: (n) =>
        `Field modulation active — ${n} vacuum channels computing. Emergency stop available at all times.`,
      aborted: 'Potentiation aborted — field collapsed in a controlled manner.',
      halfCycleDone:
        'Homeopathic half-cycle complete — potentiation finalized. Saccharose molecular memory updated.',
      fieldNominal: 'FIELD: NOMINAL',
      fieldModulating: 'FIELD: MODULATING',
      potentiating: 'POTENTIATING',
      customSubstance: 'OWN SUBSTANCE',
      canvasLabel: 'FIELD MODULATION ACTIVE',
      numberLocale: 'en-US',
    },
  };
  const L = STRINGS[document.documentElement.lang === 'en' ? 'en' : 'de'];

  const canvas = document.getElementById('q-canvas');
  const ctx = canvas.getContext('2d');
  const fluxEl = document.getElementById('q-flux');
  const entropyEl = document.getElementById('q-entropy');
  const entropyBar = document.getElementById('q-entropy-bar');
  const loadEl = document.getElementById('q-load');
  const statusEl = document.getElementById('q-status');
  const igniteBtn = document.getElementById('q-ignite');
  const abortBtn = document.getElementById('q-abort');
  const consentBox = document.getElementById('q-consent');
  const consentBtn = document.getElementById('q-consent-accept');
  const targetEl = document.getElementById('q-target');
  const navStatus = document.getElementById('field-status');
  const navDot = document.getElementById('field-status-dot');

  const HALF_CYCLE_MS = 5 * 60 * 1000;
  const PARTICLES = 90;
  const LINK_DIST = 120;

  let particles = [];
  let workers = [];
  let active = false;
  let calibrated = false;
  let consented = false;
  let startedAt = 0;
  let flux = 0;
  let timeoutId = 0;
  let frame = 0;

  // Theme-aware canvas palette, refreshed when the hidden polarity toggle fires.
  let accentCyan = '2 132 199';
  let accentPurple = '124 58 237';
  function refreshThemeColors() {
    const cs = getComputedStyle(document.documentElement);
    accentCyan = cs.getPropertyValue('--accent-cyan').trim() || accentCyan;
    accentPurple = cs.getPropertyValue('--accent-purple').trim() || accentPurple;
  }
  refreshThemeColors();
  document.addEventListener('qse:theme', refreshThemeColors);

  // Subsystem interlock: the Vacuum Potentiator stays locked until
  // subsystem 01 has delivered a substance spectrum (or its placebo).
  function unlock() {
    if (calibrated) return;
    calibrated = true;
    igniteBtn.disabled = false;
    statusEl.textContent = L.readyCalibrated;
  }
  if (document.documentElement.dataset.qseCalibrated === '1') unlock();
  document.addEventListener('qse:calibrated', unlock);

  // Target matrix and potency, fed by the substance library (subsystem 00).
  let potency = { prefix: 'D', num: 30, label: 'D30' };
  let substanceName = null;
  document.addEventListener('qse:substance', (event) => {
    const detail = event.detail || {};
    const match = String(detail.potency || '').match(/^([A-Z]+)(\d+)$/);
    if (match) potency = { prefix: match[1], num: Number(match[2]), label: detail.potency };
    substanceName = detail.custom ? null : detail.name;
    targetEl.textContent = `${(substanceName || L.customSubstance).toUpperCase()} · ${potency.label}`;
  });

  function resize() {
    const dpr = window.devicePixelRatio || 1;
    canvas.width = canvas.clientWidth * dpr;
    canvas.height = canvas.clientHeight * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function initParticles() {
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    particles = Array.from({ length: PARTICLES }, () => ({
      x: Math.random() * w,
      y: Math.random() * h,
      vx: (Math.random() - 0.5) * 0.5,
      vy: (Math.random() - 0.5) * 0.5,
      violet: Math.random() < 0.3,
    }));
  }

  function drawField() {
    frame++;
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    const speed = active ? 3.2 : 1;
    ctx.clearRect(0, 0, w, h);

    for (const p of particles) {
      p.x += p.vx * speed;
      p.y += p.vy * speed;
      if (p.x < 0 || p.x > w) p.vx *= -1;
      if (p.y < 0 || p.y > h) p.vy *= -1;
    }

    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const a = particles[i];
        const b = particles[j];
        const dx = a.x - b.x;
        const dy = a.y - b.y;
        const d2 = dx * dx + dy * dy;
        if (d2 < LINK_DIST * LINK_DIST) {
          const alpha = (1 - Math.sqrt(d2) / LINK_DIST) * (active ? 0.35 : 0.15);
          ctx.strokeStyle =
            a.violet || b.violet
              ? `rgb(${accentPurple} / ${alpha})`
              : `rgb(${accentCyan} / ${alpha})`;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }
    }

    for (const p of particles) {
      ctx.fillStyle = p.violet
        ? `rgb(${accentPurple} / 0.9)`
        : `rgb(${accentCyan} / 0.9)`;
      ctx.beginPath();
      ctx.arc(p.x, p.y, active ? 1.8 : 1.3, 0, Math.PI * 2);
      ctx.fill();
    }

    if (active) {
      const r = 40 + Math.sin(frame / 12) * 12;
      ctx.strokeStyle = `rgb(${accentCyan} / 0.5)`;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(w / 2, h / 2, r, 0, Math.PI * 2);
      ctx.stroke();
      ctx.font = '10px ui-monospace, monospace';
      ctx.fillStyle = `rgb(${accentCyan} / 0.8)`;
      ctx.textAlign = 'center';
      ctx.fillText(L.canvasLabel, w / 2, h / 2 + r + 18);
      ctx.textAlign = 'start';
    }

    requestAnimationFrame(drawField);
  }

  function ignite() {
    if (active || !calibrated) return;

    // GDPR bio-field consent: acknowledged once per page load.
    if (!consented) {
      consentBox.classList.remove('hidden');
      return;
    }

    active = true;
    startedAt = performance.now();
    const channels = Math.min(6, Math.max(1, (navigator.hardwareConcurrency || 4) - 2));

    for (let i = 0; i < channels; i++) {
      const worker = new Worker(
        new URL('../workers/vacuum-noise.worker.js', import.meta.url),
        { type: 'module' }
      );
      worker.onmessage = (event) => {
        if (event.data?.type === 'entropy-tick') {
          flux += 1337 + Math.floor(Math.random() * 420);
        }
      };
      worker.postMessage('ignite');
      workers.push(worker);
    }

    igniteBtn.disabled = true;
    abortBtn.disabled = false;
    statusEl.textContent = L.activeStatus(channels);
    navStatus.textContent = L.fieldModulating;
    navStatus.classList.add('text-flux');
    navDot.classList.replace('bg-flux', 'bg-ultraviolet');
    timeoutId = setTimeout(() => abort(L.halfCycleDone), HALF_CYCLE_MS);
    console.info(
      `[QUANTUM-ENGINE] Initializing field modulation for target: ${potency.label}`
    );
  }

  function abort(message) {
    if (!active) return;
    active = false;
    clearTimeout(timeoutId);
    workers.forEach((w) => w.terminate());
    workers = [];
    igniteBtn.disabled = false;
    abortBtn.disabled = true;
    statusEl.textContent = typeof message === 'string' ? message : L.aborted;
    navStatus.textContent = L.fieldNominal;
    navStatus.classList.remove('text-flux');
    navDot.classList.replace('bg-ultraviolet', 'bg-flux');
    console.info('[QUANTUM-ENGINE] Potentiation complete. Saccharose molecular memory updated.');
  }

  consentBtn.addEventListener('click', () => {
    consented = true;
    consentBox.classList.add('hidden');
    ignite();
  });

  setInterval(() => {
    flux += active ? 0 : Math.floor(Math.random() * 3);
    fluxEl.textContent = `${flux.toLocaleString(L.numberLocale)} Γ·s⁻¹`;
    const load = active ? 88 + Math.random() * 11 : 2 + Math.random() * 4;
    loadEl.textContent = `${load.toFixed(0)} %`;
    if (active) {
      const steps = Math.min(30, potency.num);
      const step = Math.min(steps, 1 + Math.floor((performance.now() - startedAt) / 10000));
      const level = Math.max(1, Math.round((potency.num * step) / steps));
      entropyEl.textContent = `${potency.prefix}${String(level).padStart(2, '0')} · ${L.potentiating}`;
      entropyBar.style.width = `${(step / steps) * 100}%`;
    } else {
      entropyEl.textContent = `${potency.prefix}01 · STANDBY`;
      entropyBar.style.width = '3%';
    }
  }, 250);

  igniteBtn.addEventListener('click', ignite);
  abortBtn.addEventListener('click', () => abort());
  window.addEventListener('resize', () => {
    resize();
    initParticles();
  });
  window.addEventListener('pagehide', () => abort());

  resize();
  initParticles();
  drawField();
</script>
