---
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;
const t = translations[lang];
---

<section id="engine" class="border-t border-void-700">
  <div class="mx-auto max-w-6xl px-6 py-20">
    <p class="font-mono text-[11px] tracking-[0.35em] text-ultraviolet">{t.engine.eyebrow}</p>
    <h2 class="mt-4 text-3xl font-semibold tracking-tight text-void-100 md:text-4xl">
      {t.engine.h2}
    </h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-void-300">{t.engine.body}</p>

    <div class="mt-10 grid gap-6 lg:grid-cols-[3fr,2fr]">
      <div class="relative overflow-hidden rounded border border-void-700 bg-void-950">
        <canvas id="q-canvas" class="block h-96 w-full"></canvas>
      </div>

      <div class="flex flex-col gap-4">
        <dl class="space-y-3 rounded border border-void-700 bg-void-900 p-5 font-mono text-xs">
          <div class="flex justify-between gap-4">
            <dt class="text-void-500">PHOTON_FLUX</dt>
            <dd id="q-flux" class="text-void-100">0 Γ·s⁻¹</dd>
          </div>
          <div>
            <div class="flex justify-between gap-4">
              <dt class="text-void-500">ENTROPY_STATE</dt>
              <dd id="q-entropy" class="text-void-100">{t.engine.standbyState}</dd>
            </div>
            <div class="mt-2 h-1 overflow-hidden rounded bg-void-700">
              <div
                id="q-entropy-bar"
                class="h-full bg-gradient-to-r from-flux to-ultraviolet transition-all duration-500"
                style="width: 3%"
              >
              </div>
            </div>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-void-500">CORE_LOAD</dt>
            <dd id="q-load" class="text-void-100">3 %</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-void-500">EFFICACY</dt>
            <dd class="text-void-500">0.000</dd>
          </div>
        </dl>

        <button
          id="q-ignite"
          disabled
          class="rounded border border-void-700 px-5 py-4 font-mono text-sm tracking-wider text-void-500 transition enabled:border-flux/60 enabled:bg-flux/10 enabled:text-flux enabled:shadow-flux-glow enabled:hover:bg-flux/20 disabled:cursor-not-allowed"
        >
          {t.engine.ignite}
        </button>
        <button
          id="q-abort"
          disabled
          class="rounded border border-void-700 px-5 py-4 font-mono text-sm tracking-wider text-void-500 transition enabled:border-red-500/70 enabled:bg-red-500/10 enabled:text-red-400 enabled:hover:bg-red-500/20 disabled:cursor-not-allowed"
        >
          {t.engine.abort}
        </button>

        <p id="q-status" class="font-mono text-[11px] leading-relaxed text-void-500">
          {t.engine.locked}
        </p>

        <p
          class="rounded border border-amber-500/40 bg-amber-500/5 p-3 text-[11px] leading-relaxed text-amber-200/80"
        >
          ⚠ {t.engine.warning}
        </p>

        <p class="text-[11px] leading-relaxed text-void-500">{t.engine.note}</p>
      </div>
    </div>
  </div>
</section>

<script>
  const STRINGS = {
    de: {
      locked:
        'Gesperrt — Subsystem 01 (Bio-Feld-Kalibrierung) muss zuerst ausgeführt werden. Ohne Substanz-Spektrum keine Potenzierung.',
      readyCalibrated: 'Bio-Feld kalibriert. Bereit zur Feld-Modulation.',
      activeStatus: (n) =>
        `Feld-Modulation aktiv — ${n} Vakuum-Kanäle rechnen. Notaus jederzeit verfügbar.`,
      aborted: 'Potenzierung abgebrochen — Feld kontrolliert kollabiert.',
      halfCycleDone:
        'Homöopathischer Halbzyklus abgeschlossen — Potenzierung finalisiert. Saccharose-Molekulargedächtnis aktualisiert.',
      fieldNominal: 'FELD: NOMINAL',
      fieldModulating: 'FELD: MODULIEREND',
      potentiating: 'POTENZIERUNG',
      standbyState: 'D01 · STANDBY',
      canvasLabel: 'FELD-MODULATION AKTIV',
      numberLocale: 'de-DE',
    },
    en: {
      locked:
        'Locked — subsystem 01 (bio-field calibration) must run first. No substance spectrum, no potentiation.',
      readyCalibrated: 'Bio-field calibrated. Ready for field modulation.',
      activeStatus: (n) =>
        `Field modulation active — ${n} vacuum channels computing. Emergency stop available at all times.`,
      aborted: 'Potentiation aborted — field collapsed in a controlled manner.',
      halfCycleDone:
        'Homeopathic half-cycle complete — potentiation finalized. Saccharose molecular memory updated.',
      fieldNominal: 'FIELD: NOMINAL',
      fieldModulating: 'FIELD: MODULATING',
      potentiating: 'POTENTIATING',
      standbyState: 'D01 · STANDBY',
      canvasLabel: 'FIELD MODULATION ACTIVE',
      numberLocale: 'en-US',
    },
  };
  const L = STRINGS[document.documentElement.lang === 'en' ? 'en' : 'de'];

  const canvas = document.getElementById('q-canvas');
  const ctx = canvas.getContext('2d');
  const fluxEl = document.getElementById('q-flux');
  const entropyEl = document.getElementById('q-entropy');
  const entropyBar = document.getElementById('q-entropy-bar');
  const loadEl = document.getElementById('q-load');
  const statusEl = document.getElementById('q-status');
  const igniteBtn = document.getElementById('q-ignite');
  const abortBtn = document.getElementById('q-abort');
  const navStatus = document.getElementById('field-status');
  const navDot = document.getElementById('field-status-dot');

  const HALF_CYCLE_MS = 5 * 60 * 1000;
  const PARTICLES = 90;
  const LINK_DIST = 120;

  let particles = [];
  let workers = [];
  let active = false;
  let calibrated = false;
  let startedAt = 0;
  let flux = 0;
  let timeoutId = 0;
  let frame = 0;

  // Subsystem interlock: the Vacuum Potentiator stays locked until
  // subsystem 01 has delivered a substance spectrum (or its placebo).
  function unlock() {
    if (calibrated) return;
    calibrated = true;
    igniteBtn.disabled = false;
    statusEl.textContent = L.readyCalibrated;
  }
  if (document.documentElement.dataset.qseCalibrated === '1') unlock();
  document.addEventListener('qse:calibrated', unlock);

  function resize() {
    const dpr = window.devicePixelRatio || 1;
    canvas.width = canvas.clientWidth * dpr;
    canvas.height = canvas.clientHeight * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function initParticles() {
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    particles = Array.from({ length: PARTICLES }, () => ({
      x: Math.random() * w,
      y: Math.random() * h,
      vx: (Math.random() - 0.5) * 0.5,
      vy: (Math.random() - 0.5) * 0.5,
      violet: Math.random() < 0.3,
    }));
  }

  function drawField() {
    frame++;
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    const speed = active ? 3.2 : 1;
    ctx.clearRect(0, 0, w, h);

    for (const p of particles) {
      p.x += p.vx * speed;
      p.y += p.vy * speed;
      if (p.x < 0 || p.x > w) p.vx *= -1;
      if (p.y < 0 || p.y > h) p.vy *= -1;
    }

    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const a = particles[i];
        const b = particles[j];
        const dx = a.x - b.x;
        const dy = a.y - b.y;
        const d2 = dx * dx + dy * dy;
        if (d2 < LINK_DIST * LINK_DIST) {
          const alpha = (1 - Math.sqrt(d2) / LINK_DIST) * (active ? 0.35 : 0.15);
          ctx.strokeStyle =
            a.violet || b.violet
              ? `rgba(112, 0, 255, ${alpha})`
              : `rgba(0, 240, 255, ${alpha})`;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }
    }

    for (const p of particles) {
      ctx.fillStyle = p.violet ? 'rgba(112, 0, 255, 0.9)' : 'rgba(0, 240, 255, 0.9)';
      ctx.beginPath();
      ctx.arc(p.x, p.y, active ? 1.8 : 1.3, 0, Math.PI * 2);
      ctx.fill();
    }

    if (active) {
      const r = 40 + Math.sin(frame / 12) * 12;
      ctx.strokeStyle = 'rgba(0, 240, 255, 0.5)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(w / 2, h / 2, r, 0, Math.PI * 2);
      ctx.stroke();
      ctx.font = '10px ui-monospace, monospace';
      ctx.fillStyle = 'rgba(0, 240, 255, 0.8)';
      ctx.textAlign = 'center';
      ctx.fillText(L.canvasLabel, w / 2, h / 2 + r + 18);
      ctx.textAlign = 'start';
    }

    requestAnimationFrame(drawField);
  }

  function ignite() {
    if (active || !calibrated) return;
    active = true;
    startedAt = performance.now();
    const channels = Math.min(6, Math.max(1, (navigator.hardwareConcurrency || 4) - 2));

    for (let i = 0; i < channels; i++) {
      const worker = new Worker(
        new URL('../workers/vacuum-noise.worker.js', import.meta.url),
        { type: 'module' }
      );
      worker.onmessage = (event) => {
        if (event.data?.type === 'entropy-tick') {
          flux += 1337 + Math.floor(Math.random() * 420);
        }
      };
      worker.postMessage('ignite');
      workers.push(worker);
    }

    igniteBtn.disabled = true;
    abortBtn.disabled = false;
    statusEl.textContent = L.activeStatus(channels);
    navStatus.textContent = L.fieldModulating;
    navStatus.classList.add('text-flux');
    navDot.classList.replace('bg-flux', 'bg-ultraviolet');
    timeoutId = setTimeout(() => abort(L.halfCycleDone), HALF_CYCLE_MS);
    console.info('[QUANTUM-ENGINE] Initializing field modulation for target: D30');
  }

  function abort(message) {
    if (!active) return;
    active = false;
    clearTimeout(timeoutId);
    workers.forEach((w) => w.terminate());
    workers = [];
    igniteBtn.disabled = false;
    abortBtn.disabled = true;
    statusEl.textContent = typeof message === 'string' ? message : L.aborted;
    navStatus.textContent = L.fieldNominal;
    navStatus.classList.remove('text-flux');
    navDot.classList.replace('bg-ultraviolet', 'bg-flux');
    console.info('[QUANTUM-ENGINE] Potentiation complete. Saccharose molecular memory updated.');
  }

  setInterval(() => {
    flux += active ? 0 : Math.floor(Math.random() * 3);
    fluxEl.textContent = `${flux.toLocaleString(L.numberLocale)} Γ·s⁻¹`;
    const load = active ? 88 + Math.random() * 11 : 2 + Math.random() * 4;
    loadEl.textContent = `${load.toFixed(0)} %`;
    if (active) {
      const level = Math.min(30, 1 + Math.floor((performance.now() - startedAt) / 10000));
      entropyEl.textContent = `D${String(level).padStart(2, '0')} · ${L.potentiating}`;
      entropyBar.style.width = `${(level / 30) * 100}%`;
    } else {
      entropyEl.textContent = L.standbyState;
      entropyBar.style.width = '3%';
    }
  }, 250);

  igniteBtn.addEventListener('click', ignite);
  abortBtn.addEventListener('click', () => abort());
  window.addEventListener('resize', () => {
    resize();
    initParticles();
  });
  window.addEventListener('pagehide', () => abort());

  resize();
  initParticles();
  drawField();
</script>
