---
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang?: Lang;
  deHref?: string;
  enHref?: string;
}

const { lang = 'de' } = Astro.props;
const t = translations[lang];

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const deHref = Astro.props.deHref ?? base;
const enHref = Astro.props.enHref ?? `${base}en/`;
const aboutHref = lang === 'en' ? `${base}en/about/` : `${base}ueber-uns/`;
const roadmapHref = lang === 'en' ? `${base}en/roadmap/` : `${base}roadmap/`;
const leafletHref = lang === 'en' ? `${base}en/leaflet/` : `${base}fachinformation/`;
const homeHref = lang === 'en' ? `${base}en/` : base;
const repoUrl = 'https://github.com/NullPunkt-Labs/quantum-saccharose-engine';
---

<header class="sticky top-0 z-40 border-b border-linec bg-page/80 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
    <a href={homeHref} class="group flex items-baseline gap-2">
      <span class="text-sm font-semibold tracking-[0.2em] text-ink">NULLPUNKT LABS</span>
      <span class="hidden font-mono text-xs text-muted sm:inline group-hover:text-flux/80">
        / quantum-saccharose-engine
      </span>
    </a>
    <div class="flex items-center gap-5">
      <div class="hidden items-center gap-2 font-mono text-[11px] tracking-widest md:flex">
        <span
          id="field-status-dot"
          class="h-2 w-2 animate-pulse rounded-full bg-flux shadow-flux-glow"></span>
        <span id="field-status" class="text-muted">{t.nav.fieldNominal}</span>
      </div>
      <a
        href={roadmapHref}
        class="hidden font-mono text-xs text-muted transition hover:text-flux sm:inline"
      >
        {t.nav.roadmap}
      </a>
      <a
        href={leafletHref}
        class="hidden font-mono text-xs text-muted transition hover:text-flux md:inline"
      >
        {t.nav.leaflet}
      </a>
      <a href={aboutHref} class="font-mono text-xs text-muted transition hover:text-flux">
        {t.nav.about}
      </a>
      <button
        id="font-toggle"
        type="button"
        aria-label={t.nav.fontSize}
        title={t.nav.fontSize}
        class="rounded border border-linec px-2.5 py-1 font-mono text-xs text-muted transition hover:border-flux/50 hover:text-flux"
      >A⁺</button>
      <nav class="flex items-center gap-1 font-mono text-[11px] tracking-widest">
        <a
          href={deHref}
          class:list={[
            'rounded px-2 py-1 transition',
            lang === 'de' ? 'bg-inset text-flux' : 'text-faint hover:text-muted',
          ]}>DE</a
        >
        <span class="text-linec">/</span>
        <a
          href={enHref}
          class:list={[
            'rounded px-2 py-1 transition',
            lang === 'en' ? 'bg-inset text-flux' : 'text-faint hover:text-muted',
          ]}>EN</a
        >
      </nav>
      <a
        href={repoUrl}
        rel="noopener"
        class="rounded border border-linec px-3 py-1.5 font-mono text-xs text-muted transition hover:border-flux/50 hover:text-flux"
      >
        GitHub ↗
      </a>
    </div>
  </div>
</header>

<script>
  const ft = document.getElementById('font-toggle');
  function syncFontToggle() {
    const big = document.documentElement.classList.contains('bigfont');
    ft.textContent = big ? 'A⁻' : 'A⁺';
    ft.setAttribute('aria-pressed', String(big));
  }
  ft.addEventListener('click', () => {
    const big = document.documentElement.classList.toggle('bigfont');
    localStorage.setItem('qse-font', big ? 'big' : 'normal');
    syncFontToggle();
  });
  syncFontToggle();
</script>
