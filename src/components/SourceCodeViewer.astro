---
import { Code } from 'astro:components';
import { translations, type Lang } from '../i18n/translations';
import potentiatorSource from '../engine/vacuum-potentiator.ts?raw';
import webcamSource from '../engine/webcam-resonance.ts?raw';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;
const t = translations[lang];

const files = [
  { id: 'potentiator', name: 'src/engine/vacuum-potentiator.ts', code: potentiatorSource },
  { id: 'webcam', name: 'src/engine/webcam-resonance.ts', code: webcamSource },
];
---

<section id="core" class="scroll-mt-14 border-t border-linec bg-inset/40">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
    <div class="text-center">
      <p data-reveal class="font-mono text-[11px] tracking-[0.35em] text-flux">
        {t.viewer.eyebrow}
      </p>
      <h2
        data-reveal
        style="--reveal-delay: 90ms"
        class="mx-auto mt-6 max-w-3xl text-3xl font-semibold leading-tight tracking-tight text-ink md:text-5xl"
      >
        {t.viewer.h2}
      </h2>
      <p
        data-reveal
        style="--reveal-delay: 180ms"
        class="mx-auto mt-6 max-w-2xl leading-relaxed text-muted"
      >
        {t.viewer.body}
      </p>
    </div>

    <div
      data-reveal
      style="--reveal-delay: 270ms"
      class="mt-14 overflow-hidden rounded-xl border border-linec bg-surface shadow-card"
    >
      <div class="flex border-b border-linec bg-inset font-mono text-xs">
        {
          files.map((file, index) => (
            <button
              type="button"
              data-code-tab={file.id}
              class:list={[
                'border-r border-linec px-4 py-2.5 transition hover:text-flux',
                index === 0 ? 'bg-surface text-flux' : 'text-muted',
              ]}
            >
              {file.name}
            </button>
          ))
        }
      </div>
      {
        files.map((file, index) => (
          <div data-code-panel={file.id} class:list={[index !== 0 && 'hidden']}>
            <Code
              code={file.code}
              lang="ts"
              themes={{ light: 'catppuccin-latte', dark: 'houston' }}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .astro-code {
    max-height: 32rem;
    overflow: auto;
    padding: 1.25rem;
    font-size: 12px;
    line-height: 1.7;
  }
  html.dark .astro-code,
  html.dark .astro-code span {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
  }
</style>

<script>
  const tabs = document.querySelectorAll('[data-code-tab]');
  const panels = document.querySelectorAll('[data-code-panel]');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const id = tab.getAttribute('data-code-tab');
      tabs.forEach((t) => {
        const isActive = t === tab;
        t.classList.toggle('bg-surface', isActive);
        t.classList.toggle('text-flux', isActive);
        t.classList.toggle('text-muted', !isActive);
      });
      panels.forEach((p) => {
        p.classList.toggle('hidden', p.getAttribute('data-code-panel') !== id);
      });
    });
  });
</script>
