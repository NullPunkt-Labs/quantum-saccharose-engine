---
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  altDePath?: string;
  altEnPath?: string;
}

const { lang = 'de', altDePath = '', altEnPath = 'en/' } = Astro.props;
const t = translations[lang];
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const deUrl = Astro.site ? new URL(`${base}${altDePath}`, Astro.site) : `${base}${altDePath}`;
const enUrl = Astro.site ? new URL(`${base}${altEnPath}`, Astro.site) : `${base}${altEnPath}`;
const repoUrl = 'https://github.com/NullPunkt-Labs/quantum-saccharose-engine';
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={deUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nullpunkt Labs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'de_DE'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'de_DE' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      document.documentElement.classList.add('js');
      if (localStorage.getItem('qse-theme') === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>

    <style is:global>
      :root {
        --bg-primary: 248 250 252;
        --bg-surface: 255 255 255;
        --bg-border: 203 213 225;
        --bg-inset: 241 245 249;
        --text-main: 15 23 42;
        --text-muted: 71 85 105;
        --text-faint: 100 116 139;
        --accent-cyan: 2 132 199;
        --accent-purple: 124 58 237;
        --grid-color: rgba(2, 132, 199, 0.08);
      }
      html.dark {
        --bg-primary: 8 9 11;
        --bg-surface: 13 15 18;
        --bg-border: 30 34 41;
        --bg-inset: 21 24 29;
        --text-main: 230 233 238;
        --text-muted: 139 147 161;
        --text-faint: 107 114 128;
        --accent-cyan: 0 240 255;
        --accent-purple: 112 0 255;
        --grid-color: rgba(58, 64, 75, 0.25);
      }

      html {
        background-color: rgb(var(--bg-primary));
      }

      /* Scroll reveal — only when JS is available, honors reduced motion. */
      html.js [data-reveal] {
        opacity: 0;
        transform: translateY(36px) scale(0.985);
        transition:
          opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms),
          transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms);
        will-change: opacity, transform;
      }
      html.js [data-reveal].is-revealed {
        opacity: 1;
        transform: none;
      }
      @media (prefers-reduced-motion: reduce) {
        html.js [data-reveal] {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>
  </head>
  <body
    class="min-h-screen font-sans text-ink antialiased selection:bg-flux/20 selection:text-flux"
  >
    <canvas
      id="bg-matrix"
      class="pointer-events-none fixed inset-0 z-30 h-full w-full"
      aria-hidden="true"></canvas>
    <div
      class="border-b border-linec bg-surface px-4 py-1.5 text-center font-mono text-[11px] tracking-widest text-muted"
    >
      OPEN SOURCE · MIT ·
      <a href={repoUrl} class="text-flux/80 hover:text-flux" rel="noopener">
        github.com/NullPunkt-Labs/quantum-saccharose-engine
      </a>
    </div>

    <slot />

    <footer class="border-t border-linec bg-surface">
      <div class="mx-auto max-w-6xl px-6 py-10">
        <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
          <div>
            <p class="font-semibold tracking-wide text-ink">NULLPUNKT LABS</p>
            <p class="mt-1 font-mono text-xs text-muted">{t.footer.tagline}</p>
          </div>
          <nav class="flex gap-6 font-mono text-xs text-muted">
            <a href={`${base}${lang === 'en' ? 'en/about/' : 'ueber-uns/'}`} class="hover:text-flux">
              {t.nav.about}
            </a>
            <a href={repoUrl} class="hover:text-flux" rel="noopener">GitHub</a>
            <a href={`${repoUrl}/blob/main/LICENSE`} class="hover:text-flux" rel="noopener">
              {t.footer.license}
            </a>
            <a
              href={`${repoUrl}/blob/main/DISCLAIMER.md`}
              class="hover:text-flux"
              rel="noopener"
            >
              {t.footer.leaflet}
            </a>
          </nav>
        </div>
        <details class="mt-8 rounded border border-linec bg-inset/60">
          <summary
            class="cursor-pointer px-4 py-2 font-mono text-[11px] tracking-widest text-faint hover:text-muted"
          >
            {t.footer.changelogLabel}
          </summary>
          <ul class="space-y-2 border-t border-linec px-4 py-3 font-mono text-[11px] leading-relaxed text-faint">
            {t.footer.changelog.map((entry) => <li>{entry}</li>)}
          </ul>
        </details>
        <p class="mt-6 flex items-end justify-between gap-4 text-[11px] leading-relaxed text-faint">
          <span>
            {t.footer.smallprint}
            <a
              href={`${repoUrl}/blob/main/DISCLAIMER.md`}
              class="underline decoration-linec underline-offset-2 hover:text-muted"
              rel="noopener">{t.footer.smallprintLink}</a
            >
            {t.footer.smallprintEnd}
          </span>
          <button
            id="polarity-toggle"
            class="mb-1 h-1.5 w-1.5 shrink-0 rounded-full bg-linec transition hover:bg-flux"
            aria-label="Feld-Polarität invertieren"
            title="⏻"></button>
        </p>
      </div>
    </footer>

    <script>
      const en = document.documentElement.lang === 'en';
      console.info(
        '%c[NULLPUNKT LABS] quantum-saccharose-engine v0.1.0 — field integrity nominal.',
        'color:#0284c7;font-weight:bold'
      );
      console.info(
        en
          ? '[QUANTUM-ENGINE] Note for console readers: EFFICACY stays at 0.000 — the only honest metric in this application. ' +
              'This is a satirical art project; homeopathy does not work, and this engine potentiates nothing but your electricity bill. ' +
              'The webcam stream never leaves your device. Package leaflet: ' +
              'https://github.com/NullPunkt-Labs/quantum-saccharose-engine/blob/main/DISCLAIMER.md'
          : '[QUANTUM-ENGINE] Hinweis für Konsolen-Leser: EFFICACY bleibt 0.000 — der einzige ehrliche Messwert dieser Anwendung. ' +
              'Dies ist ein satirisches Kunstprojekt; Homöopathie funktioniert nicht, und diese Engine potenziert ausschließlich Ihre Stromrechnung. ' +
              'Der Webcam-Stream verlässt niemals Ihr Gerät. Fachinformation: ' +
              'https://github.com/NullPunkt-Labs/quantum-saccharose-engine/blob/main/DISCLAIMER.md'
      );

      // Hidden field polarity inverter. Finding it is part of the therapy.
      document.getElementById('polarity-toggle')?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('qse-theme', dark ? 'dark' : 'light');
        document.dispatchEvent(new CustomEvent('qse:theme'));
        console.info(
          dark
            ? '[QUANTUM-ENGINE] Field polarity inverted. Welcome back, night shift.'
            : '[QUANTUM-ENGINE] Field polarity restored to clinical standard illumination.'
        );
      });
    </script>

    <script>
      // Ambient dot matrix — the site-wide, sedated cousin of the engine field.
      const bg = document.getElementById('bg-matrix');
      const bctx = bg.getContext('2d');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      let cyan = '2 132 199';
      let purple = '124 58 237';
      function refreshBgColors() {
        const cs = getComputedStyle(document.documentElement);
        cyan = cs.getPropertyValue('--accent-cyan').trim() || cyan;
        purple = cs.getPropertyValue('--accent-purple').trim() || purple;
      }
      refreshBgColors();
      document.addEventListener('qse:theme', refreshBgColors);

      let dots = [];
      function resizeBg() {
        const dpr = Math.min(2, window.devicePixelRatio || 1);
        bg.width = window.innerWidth * dpr;
        bg.height = window.innerHeight * dpr;
        bctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const count = Math.min(120, Math.round((window.innerWidth * window.innerHeight) / 15000));
        dots = Array.from({ length: count }, () => ({
          x: Math.random() * window.innerWidth,
          y: Math.random() * window.innerHeight,
          vx: (Math.random() - 0.5) * 0.18,
          vy: (Math.random() - 0.5) * 0.18,
          violet: Math.random() < 0.25,
        }));
      }

      const BG_LINK = 110;
      function drawBg() {
        const w = window.innerWidth;
        const h = window.innerHeight;
        bctx.clearRect(0, 0, w, h);

        for (const d of dots) {
          d.x += d.vx;
          d.y += d.vy;
          if (d.x < 0 || d.x > w) d.vx *= -1;
          if (d.y < 0 || d.y > h) d.vy *= -1;
        }

        for (let i = 0; i < dots.length; i++) {
          for (let j = i + 1; j < dots.length; j++) {
            const a = dots[i];
            const b = dots[j];
            const dx = a.x - b.x;
            const dy = a.y - b.y;
            const d2 = dx * dx + dy * dy;
            if (d2 < BG_LINK * BG_LINK) {
              const alpha = (1 - Math.sqrt(d2) / BG_LINK) * 0.2;
              bctx.strokeStyle =
                a.violet || b.violet ? `rgb(${purple} / ${alpha})` : `rgb(${cyan} / ${alpha})`;
              bctx.lineWidth = 1;
              bctx.beginPath();
              bctx.moveTo(a.x, a.y);
              bctx.lineTo(b.x, b.y);
              bctx.stroke();
            }
          }
        }

        for (const d of dots) {
          bctx.fillStyle = d.violet ? `rgb(${purple} / 0.65)` : `rgb(${cyan} / 0.65)`;
          bctx.beginPath();
          bctx.arc(d.x, d.y, 1.9, 0, Math.PI * 2);
          bctx.fill();
        }

        if (!reducedMotion) requestAnimationFrame(drawBg);
      }

      window.addEventListener('resize', () => {
        resizeBg();
        if (reducedMotion) drawBg();
      });
      resizeBg();
      drawBg();

      // Apple-style staggered section reveal.
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -48px 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
